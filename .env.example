# Copy to .env and `set -a; source .env; set +a` before starting uvicorn (the app reads plain env vars).
MODEL_PATH=model.joblib          # required: Task 1 model bundle
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_ENV=development              # development | test | production (production = exit if the model can't load)
MAX_BODY_BYTES=16384             # larger request bodies -> 413
HOST=127.0.0.1
PORT=8000
# Batch CSV checking (POST /analyze-batch) and stored reports
MAX_UPLOAD_BYTES=52428800        # largest CSV accepted (50 MB) -> 413 above
MAX_UPLOAD_ROWS=200000           # most orders per file -> 413 above
BATCH_CHUNK_SIZE=10000           # rows scored per model call
REPORTS_DIR=reports              # where reports are saved (created at startup; must be writable)
REPORT_TTL_MINUTES=1440          # reports are deleted after this many minutes (1 day)
MAX_REPORTS=50                   # keep at most this many reports; the oldest go first
